{
  "expo": {
    "name": "OnlyMaxon",
    "slug": "onlymaxon-cards",
    "owner": "onlymaxons-team",
    "version": "1.2.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "maxoncards",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#06080C",
    "ios": {
      "bundleIdentifier": "com.onlymaxon.cards",
      "buildNumber": "10",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "package": "com.onlymaxon.nfc",
      "versionCode": 15,
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "backgroundColor": "#06080C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.NFC"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      [
        "react-native-nfc-manager",
        {
          "nfcPermission": "OnlyMaxon reads and writes the chip inside your NFC card.",
          "includeNdefEntitlement": false
        }
      ],
      "expo-secure-store",
      "./plugins/with-portrait-optional",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "dynamic"
          },
          "android": {
            "kotlinVersion": "2.4.20",
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class community.revteltech.nfc.** { *; }"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "OnlyMaxon needs your photo library so you can choose the picture that appears on your card.",
          "cameraPermission": "OnlyMaxon needs the camera so you can take the picture that appears on your card.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#06080C",
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "dark": {
            "backgroundColor": "#06080C",
            "image": "./assets/splash-icon.png",
            "imageWidth": 220
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "4475f550-41ee-4f9e-9fef-880e9d3ae218"
      }
    }
  }
}
