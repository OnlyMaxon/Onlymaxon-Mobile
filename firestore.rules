rules_version = '2';

/*
 * Who may touch a card.
 *
 * The shape of this product decides the shape of these rules: a card exists before its
 * owner does. It is created at the bench, with the client's email on it and nobody's
 * account attached, and the client turns up afterwards — so there has to be a moment where
 * a stranger proves they are the person the card was made for, and takes it.
 *
 * That proof is the verified email address, which is the whole reason the app asks for one.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // A confirmed address, not just a typed one. Firebase puts this claim in the token
    // itself, so nothing here has to trust a field somebody could write.
    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    /*
     * One spelling of an address, here as well as in the app.
     *
     * Firebase keeps whatever case was typed at registration, so a client who signed up as
     * Anna@Salon.pl carries exactly that in the token — while every ownerEmail we write is
     * lowercased, in src/account.ts and at the bench. Comparing the two as given means that
     * client can neither claim the card made for them nor create one, and the only symptom
     * is "permission denied". Proven in the emulator, not guessed at.
     */
    function myEmail() {
      return request.auth.token.email.lower();
    }

    // Cards are created at the bench, by us, while writing the chip — there is no sign-up
    // that produces one. The list is written here rather than in a collection on purpose:
    // a document can be created by anything that gets hold of a write, while this can only
    // change by deploying rules. Adding a second admin is a one-line edit and a deploy.
    function admin() {
      return verified() && request.auth.token.email in [
        'calilorucli42@gmail.com'
      ];
    }

    function owns(card) {
      return signedIn() && card.ownerUid == request.auth.uid;
    }

    // The person the card was made for, before they have claimed it.
    function waitingFor(card) {
      return verified()
        && card.ownerUid == null
        && card.ownerEmail == myEmail();
    }

    match /cards/{cardId} {

      /*
       * Nobody reads a card from a client except the people it concerns.
       *
       * It is tempting to let anyone read a published card — "that is what a card is" — but
       * the document holds ownerEmail and ownerUid alongside the public fields, and a rule
       * cannot hand over half a document. The page a stranger sees is rendered by the
       * Cloud Function, which reads through the Admin SDK and is not governed by these
       * rules at all, so the public half costs nothing here.
       */
      /*
       * The uid branch comes first, and it has to.
       *
       * `cards/<uid>` is the one document a person may create for themselves, so the
       * transaction that creates it reads it first to see whether it is already there. On a
       * document that does not exist `resource` is null, and `owns(resource.data)` is then
       * not false but an *error* — which denies the read, fails the transaction and shows
       * somebody standing there with a blank card "permission denied". Rules stop at the
       * first branch that is true, so a safe test that never touches `resource` must be the
       * first one. This is the bug the emulator found on 2026-11-23.
       *
       * It gives away nothing: a document whose id is your own uid is yours by
       * construction, and the create rule below is what makes that true.
       */
      allow get: if (signedIn() && cardId == request.auth.uid)
                 || owns(resource.data)
                 || waitingFor(resource.data)
                 || admin();

      // Listing is how the app finds "my cards". Each document in the result has to pass,
      // so a query that is not filtered to this person simply returns an error rather than
      // somebody else's rows.
      allow list: if owns(resource.data) || waitingFor(resource.data) || admin();

      /*
       * Two ways a card comes into existence.
       *
       * At the bench, by us: the slug and the client's email are typed in, nobody owns it
       * yet, and the client claims it afterwards with a confirmed address. That is how
       * every card was made until the order for three hundred of them made it impossible.
       *
       * Or by the person themselves, at registration. They own it from the first moment, so
       * there is no claim step and no window where a row belongs to an address rather than
       * to an account. Three things keep that honest:
       *
       *   - the document id must be their uid. Rules cannot count documents, so "one card
       *     per account" has no expression as a condition — but an id that can only be the
       *     uid says the same thing, and update on this branch is refused below, so the
       *     slug they take cannot later be swapped for another.
       *   - the address has to be confirmed. Without that, an afternoon of throwaway
       *     addresses could take every short slug we will ever want to print.
       *   - the slug has to look like a slug, because it is about to be printed on plastic
       *     and because it ends up in a URL. The same expression as SLUG_RE in src/cards.ts.
       *
       * `published` is not on that list, on this branch only. It had to be false, which
       * meant a person's own card arrived hidden behind a warning and a button before they
       * could see the thing they had just registered for; the app now creates it visible.
       * Whether a card of theirs is visible was never ours to decide either way — the
       * update branch below lets them flip it a second later. The clause is deleted rather
       * than inverted so that both the version in the stores, which sends false, and the
       * one replacing it, which sends true, are accepted: no registration falls into the
       * gap between a rules deploy and a store review. The bench branch above still
       * insists on false, because that card has no owner and no name on it yet.
       */
      allow create: if (admin()
                      && request.resource.data.ownerUid == null
                      && request.resource.data.published == false)

                    || (verified()
                      && cardId == request.auth.uid
                      && request.resource.data.ownerUid == request.auth.uid
                      && request.resource.data.ownerEmail == myEmail()
                      && request.resource.data.slug is string
                      && request.resource.data.slug.matches('^[a-z0-9][a-z0-9-]{1,38}$')
                      && request.resource.data.get('photoPath', '') == '');

      allow update: if
        // The owner editing their own card. They may not hand it to somebody else, and
        // they may not change the slug — it is printed on plastic that cannot be reissued.
        //
        // photoPath is on that list too, for a sharper reason: it is a path into the
        // storage bucket. An owner who could write it freely could point their own card at
        // any object in it — another client's face, served under their own name. Only the
        // `photo` function sets it, with admin rights, after hashing the bytes it was
        // handed. The editor sends every other field and leaves this one exactly as found.
        (owns(resource.data)
          && verified()
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.ownerEmail == resource.data.ownerEmail
          && request.resource.data.slug == resource.data.slug
          && request.resource.data.get('photoPath', '') == resource.data.get('photoPath', ''))

        // Or the claim: an unclaimed card, taken by the verified address it was made for.
        // The only field this is allowed to set is the owner.
        || (waitingFor(resource.data)
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerEmail == resource.data.ownerEmail
          && request.resource.data.slug == resource.data.slug)

        // Or the owner letting go of it, which is what deleting an account does. It comes
        // back hidden and unclaimed, keeping the slug and the address it was issued to —
        // the row has to survive, because the slug is printed on plastic. Verification is
        // deliberately not required here: somebody must always be able to delete their
        // account, confirmed address or not.
        //
        // This branch is the one place a client may write photoPath, and only to empty it.
        // Letting go of a card has to take the face off it: the slug stays printed on
        // plastic, the row stays, and a stranger tapping it must not meet the person who
        // just asked to be erased. The app deletes the file itself first; this makes the
        // page stop pointing at it even if that call did not get through.
        || (owns(resource.data)
          && request.resource.data.ownerUid == null
          && request.resource.data.ownerEmail == resource.data.ownerEmail
          && request.resource.data.slug == resource.data.slug
          && request.resource.data.published == false
          && request.resource.data.get('photoPath', '') == '');

      // Nothing deletes a card. The URL is on a physical object: deleting the row would
      // turn a card in somebody's pocket into a 404 with no way to tell from looking at it.
      allow delete: if false;
    }

    /*
     * The physical chip behind a card: which batch password protects it, what its UID is,
     * when it was written.
     *
     * Deliberately NOT fields on the card document. A client reads their own card in full,
     * and a rule cannot hand over half a document — so a batch password stored there would
     * be readable by every client, and with it they could rewrite any chip in that batch,
     * including other people's. Here it is admin-only, like the batch list itself.
     */
    match /chips/{chipUid} {
      allow read, write: if admin();
    }

    /*
     * Every attempt on one chip, in order, and nobody may edit the past.
     *
     * A subcollection rather than a collection of its own, because the console is read by a
     * person: the history belongs inside the chip it is about. The document above is the
     * current state of a piece of plastic and is overwritten by design. This is the history, and it exists because the state document once quietly disagreed
     * with the chip it described: the write that corrected it never reached the database,
     * the failure was swallowed, and a card already in somebody's pocket was left carrying
     * a password that nothing on record could open.
     *
     * Create only. A log that can be updated is a log that can be made to say the write
     * went fine.
     */
    match /chips/{chipUid}/writes/{entryId} {
      allow get, list: if admin();
      allow create: if admin();
      allow update, delete: if false;
    }

    /*
     * Batch passwords.
     *
     * These used to live only in the phone keychain, and a reinstall took the only copy
     * with it — leaving chips that can be read forever and written never. A password that
     * exists in exactly one place is not a secret, it is a single point of failure.
     *
     * Here it is readable and writable by admins and nobody else: the same people who can
     * create cards, which is the same people who hold the chips. A client cannot reach it,
     * and neither can anyone signed in but not on the list.
     */
    match /batches/{batchId} {
      allow read, write: if admin();
    }

    /*
     * One document per slug, id = the slug itself. Firestore has no unique index, and this
     * is the standard way to buy one: the create fails if the document is already there,
     * inside the same transaction that writes the card.
     */
    match /slugs/{slug} {
      /*
       * One document asked for by name, which is all the transaction that creates a card
       * needs — and all a client is given. Whether one slug is taken is not a secret: the
       * page at cards.onlymaxon.com/<slug> answers the same question to anybody with a
       * browser. Which slugs exist, as a list, is a directory of our clients, so `list`
       * stays where it was.
       */
      allow get: if admin() || verified();
      allow list: if admin();

      /*
       * Created by us at the bench, or by the person whose own card it is about to point
       * at. Tying cardId to the uid is what stops one account from quietly taking a
       * hundred names: the only slug it can lock is the one belonging to the single card
       * it is allowed to create.
       */
      allow create: if admin()
                    || (verified() && request.resource.data.cardId == request.auth.uid);

      // Never. A slug is printed on plastic and must never be handed out twice, so a
      // document here outlives the card, the account and the chip.
      allow update, delete: if false;
    }

    /*
     * What each account did with its card: activated it, rewrote the chip, wiped it, and
     * whether the attempt succeeded — with the app, its version and the platform beside
     * each entry.
     *
     * Written by the `activity` function and by nothing else. The Admin SDK is not governed
     * by these rules, so there is no write branch here at all: a client that could append
     * to its own history could also write a history that never happened, and the point of
     * the log is that it is ours rather than theirs.
     *
     * Read by admins only. The person's own card already tells them its state; this exists
     * so that when a chip misbehaves in somebody's pocket we can see what was done to it.
     */
    match /activity/{uid}/events/{entryId} {
      allow get, list: if admin();
      allow write: if false;
    }

    // Anything not named above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
